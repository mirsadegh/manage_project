# === Django ===
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True  # Set to False in production
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins.
# In production, set to your frontend domain(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# === Database ===
# Option 1: DATABASE_URL (takes priority)
DATABASE_URL=postgresql://pm_user:pm_password@localhost:5432/project_mgmt

# Option 2: Individual vars (used if DATABASE_URL is not set)
POSTGRES_DB=project_mgmt
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=pm_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_secret_password

# === ClamAV ===
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# === Email (optional) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# === Security (production only) ===
AUTH_COOKIE_SECURE=true
TRUSTED_PROXY_CIDRS=
MAX_CONNECTIONS_PER_USER=5
WS_MAX_MESSAGE_SIZE=65536
LOGIN_THROTTLE_RATE=10/hour

</content>